# Sinch credentials (from dashboard.sinch.com → Access Keys)
SINCH_PROJECT_ID=
SINCH_KEY_ID=
SINCH_KEY_SECRET=

# The service that owns your Sinch number (Dashboard → Voice → Services).
# This is the service whose callBehavior configure_service.py switches to WEBHOOK.
SINCH_SERVICE_ID=

# Your Sinch virtual number, in E.164 format, routed to the service above
SINCH_NUMBER=
# The agent number the call bridges to, in E.164 format (any phone you can answer)
DESTINATION_NUMBER=

# Local server port
PORT=3000

# Public URL of the server, including the /voice/events path (e.g. https://<id>.ngrok-free.app/voice/events)
WEBHOOK_URL=
