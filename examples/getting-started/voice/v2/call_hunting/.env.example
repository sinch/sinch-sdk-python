# Sinch credentials (from dashboard.sinch.com → Access Keys)
SINCH_PROJECT_ID=
SINCH_KEY_ID=
SINCH_KEY_SECRET=

# Your Sinch virtual number, in E.164 format. Caller ID on every outbound leg
SINCH_NUMBER=
# The customer you connect the agent to, in E.164 format
CUSTOMER_NUMBER=
# Comma-separated agent numbers, in E.164 format (e.g. +15551110001,+15551110002,+15551110003).
# sequential_hunt.py and sim_ring.py read the first three; server.py reads the whole list
AGENT_NUMBERS=

# Webhook-driven hunt only (configure_service.py, start_customer_call.py, server.py)
# The service that owns your Sinch number (Dashboard → Voice → Services)
SINCH_SERVICE_ID=
# Public HTTPS base URL of the server, without path (e.g. https://<id>.ngrok-free.app)
CALLBACK_URL=
# Local server port
PORT=3000
