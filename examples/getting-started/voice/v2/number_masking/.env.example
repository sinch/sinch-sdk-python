# Sinch credentials (from dashboard.sinch.com → Access Keys)
SINCH_PROJECT_ID=
SINCH_KEY_ID=
SINCH_KEY_SECRET=

# The service that owns your Sinch number (Dashboard → Voice → Services).
# This is the service whose callBehavior configure_service.py switches to WEBHOOK.
SINCH_SERVICE_ID=

# Your Sinch virtual number, in E.164 format. This is the masking number both parties see
SINCH_NUMBER=
# Party B, the number the inbound caller gets bridged to, in E.164 format (any phone you can answer)
DESTINATION_NUMBER=

# Local server port
PORT=3000

# Public URL of the server, including the /webhook path (e.g. https://<id>.ngrok-free.app/webhook)
WEBHOOK_URL=

# Optional, for masked_bridge_call.py: the two parties to bridge, in E.164 format.
# Default to DESTINATION_NUMBER and SINCH_NUMBER; set both to phones you can answer for a real two-party test.
PARTY_A_NUMBER=
PARTY_B_NUMBER=
