# Sinch credentials (from dashboard.sinch.com → Access Keys)
SINCH_PROJECT_ID=
SINCH_KEY_ID=
SINCH_KEY_SECRET=

# Your Sinch virtual number, in E.164 format (e.g. +15551234567)
SINCH_NUMBER=
# Your mobile, in E.164 format (answer this one)
CALLER_NUMBER=
# The primary number, in E.164 format (let this ring out)
PRIMARY_NUMBER=
# The fallback number, in E.164 format (should ring after the primary times out)
FALLBACK_NUMBER=
