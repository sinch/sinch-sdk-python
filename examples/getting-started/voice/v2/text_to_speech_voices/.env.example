# Sinch credentials (from dashboard.sinch.com → Access Keys)
SINCH_PROJECT_ID=
SINCH_KEY_ID=
SINCH_KEY_SECRET=

# Your Sinch virtual number, in E.164 format (e.g. +14045001000)
SINCH_NUMBER=
# The phone number to call, in E.164 format (e.g. +14155551234)
DESTINATION_NUMBER=

# Optional, for tts_sampler.py: voices for the plain text and SSML messages (default Emma and Brian)
VOICE_PLAIN=
VOICE_SSML=
