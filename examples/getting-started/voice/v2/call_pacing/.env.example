# Sinch credentials (from dashboard.sinch.com → Access Keys)
SINCH_PROJECT_ID=
SINCH_KEY_ID=
SINCH_KEY_SECRET=

# Your Sinch virtual number, in E.164 format (e.g. +14045001000)
SINCH_NUMBER=
# The two phone numbers to call, in E.164 format (e.g. +15551110001)
DEST_1=
DEST_2=

# Optional pacing (defaults shown)
MAX_CPS=5
TTL_SECONDS=1800

# The batch ID returned by create_batch.py (used by poll_batch.py)
BATCH_ID=
