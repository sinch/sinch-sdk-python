# Sinch credentials (from dashboard.sinch.com → Access Keys)
SINCH_PROJECT_ID=
SINCH_KEY_ID=
SINCH_KEY_SECRET=

# SINCH_SMS_REGION is required.
# Set it to the same region as the one your SMS service plan was created in (e.g. us).
SINCH_SMS_REGION=

# SMS Service Plan ID related credentials
# if set, these credentials will be used and enable to use other regions than only US/EU
#SINCH_SERVICE_PLAN_ID= <Your Service Plan ID>
#SINCH_API_TOKEN= <Your Service Plan Token>
