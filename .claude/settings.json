{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/inject-conventions.sh\"",
            "timeout": 20,
            "statusMessage": "Loading operation-id mapping\u2026"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/baseline-gate.sh\"",
            "timeout": 900,
            "statusMessage": "Baseline: integration tests on the current SDK\u2026"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/verify-gate.sh\"",
            "timeout": 2400,
            "statusMessage": "Verifying (3a tidy & build, 3b spec conformance)\u2026"
          }
        ]
      }
    ]
  }
}
